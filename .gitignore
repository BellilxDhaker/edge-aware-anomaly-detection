*.tar
*.tar.xz
*.tar.gz
*.tgz
*.zip

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local environment values (MVTec download link is issued per person; never commit)
.env

# Notebooks / Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
